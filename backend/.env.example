# APPLICATION VARIABLES
APP_NAME="Hotel Room Booking System"
APP_PORT=5001
APP_NODE_ENV=development
APP_BASE_URL=http://localhost:5001
APP_SERVICE_URL=http://localhost:3034
APP_LOG_LEVEL=info

# DATABASE VARIABLES
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

# JWT VARIABLES
JWT_SECRET_KEY=your_jwt_access_secret_key
JWT_REFRESH_TOKEN_SECRET_KEY=your_jwt_refresh_secret_key
JWT_ACCESS_TOKEN_EXPIRES=60m
JWT_REFRESH_TOKEN_EXPIRES=30d
JWT_TOKEN_COOKIE_EXPIRES=30

# EMAIL VARIABLES
SEND_SENDER_MAIL=your_email@example.com
SEND_GRID_API_KEY=SG.your_sendgrid_api_key
