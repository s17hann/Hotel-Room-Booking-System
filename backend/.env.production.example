# Production Environment Configuration - Backend
APP_NODE_ENV=production
APP_PORT=5000
APP_BASE_URL=https://api.yourhoteldomain.com

# MongoDB Atlas Connection URI (Replace credentials with your MongoDB Atlas cluster)
# mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://hotel_admin:STRONG_PASSWORD_HERE@cluster0.mongodb.net/hotel_db?retryWrites=true&w=majority

# Security Secrets (Generate using `openssl rand -hex 32`)
JWT_SECRET=GENERATE_STRONG_RANDOM_SECRET_KEY_HERE
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# CORS Whitelist (Include your Vercel deployment URL)
CORS_ORIGIN=https://hotel-booking.vercel.app,https://yourhoteldomain.com

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=noreply@yourhoteldomain.com
